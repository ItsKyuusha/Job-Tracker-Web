# Supabase
# Dapatkan dari: https://supabase.com/dashboard/project/<project-id>/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key - JANGAN ekspos di browser, hanya untuk server-side
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Job Scraper Service API Endpoint
# Default local: http://localhost:3001 | Production: https://job-scraper-service-seven.vercel.app
NEXT_PUBLIC_SCRAPER_API_URL=https://job-scraper-service-seven.vercel.app
